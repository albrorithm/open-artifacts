{
  "name": "open-artifacts",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test:probe:local": "node scripts/check-local-probe.mjs",
    "test:artifacts:local": "node scripts/check-artifacts-local.mjs",
    "test:plugins": "python3 scripts/check-plugins.py",
    "test:release": "python3 tests/plugin-release.test.py",
    "package:plugin": "python3 scripts/package-plugin.py",
    "dev:selfhost": "node --experimental-strip-types scripts/selfhost.mjs dev",
    "build:selfhost": "node --experimental-strip-types scripts/selfhost.mjs build",
    "start:selfhost": "node --experimental-strip-types scripts/selfhost.mjs start",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
    "test:probe:selfhost": "node scripts/check-selfhost-probe.mjs",
    "test:artifacts:selfhost": "node scripts/check-selfhost-artifacts.mjs",
    "package:selfhost": "node scripts/package-selfhost.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "type": "module"
}
